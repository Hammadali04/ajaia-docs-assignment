    "@tiptap/starter-kit": "^2.5.9",
    "next": "14.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "prisma": "^5.15.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
